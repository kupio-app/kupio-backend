# PostgreSQL - all fields required, no defaults
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__DB=kupio
POSTGRES__USER=kupio
POSTGRES__PASSWORD=changeme

# Redis - all fields required, no defaults
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# Auth
AUTH__JWT_SECRET=changeme
AUTH__JWT_ALGORITHM=HS256
AUTH__ACCESS_TTL=15
AUTH__REFRESH_TTL=7
AUTH__GOOGLE_CLIENT_IDS=["id1","id2","id3"]
# AUTH__NOT_VALIDATE_EXP=false  # enable only for testing

# Server
SERVER__HOST=localhost
SERVER__PORT=9988
SERVER__RELOAD=false
SERVER__DEBUG=false

# Firebase
FIREBASE__CREDENTIALS_PATH=firebase-creds.json
FIREBASE__PROJECT_ID=

# Stripe
STRIPE__SECRET_KEY=sk_test
STRIPE__WEBHOOK_SECRET=whsec_test
STRIPE__SUCCESS_URL=
STRIPE__CANCEL_URL=

# S3
S3__BUCKET=your-bucket
S3__REGION=your-region
